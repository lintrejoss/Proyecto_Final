# Configuración del Entorno - Sistema de Préstamos
# Copiar este archivo como .env y personalizar valores para el entorno local.

APP_NAME="Sistema de Préstamos de Herramientas y Equipos"
APP_ENV="development"
DEBUG=True
PORT=8000

# Base de datos PostgreSQL (Predeterminada)
# Formato: postgresql+psycopg2://<usuario>:<password>@<host>:<puerto>/<nombre_db>
DATABASE_URL="postgresql+psycopg2://postgres:postgres@localhost:5432/prestamos_db"

# Para pruebas rápidas o cuando PostgreSQL no esté disponible localmente,
# se puede utilizar SQLite (descomentar la siguiente línea):
# DATABASE_URL="sqlite:///./prestamos.db"

# Seguridad y JWT (Generar una clave secreta segura en producción con: openssl rand -hex 32)
JWT_SECRET_KEY="clave-secreta-de-desarrollo-cambiar-en-produccion"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Zona Horaria (Colombia)
TIMEZONE="America/Bogota"

